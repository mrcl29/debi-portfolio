---
// src/pages/[lang]/inspo.astro
import MainLayout from '@/layouts/MainLayout.astro';
import { languages } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
      return { params: { lang } };
  });
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const images = t.pages.inspo.images || [];

// Shuffling on the server for initial static render
const shuffledImages = [...images].sort(() => Math.random() - 0.5);
---

<MainLayout title={t.pages.inspo.title} lang={lang as string}>
    <div id="inspo-container" class="inspo-container relative w-full h-full overflow-hidden bg-transparent cursor-grab active:cursor-grabbing select-none">
        <div id="inspo-track" class="inspo-track flex flex-col">
            <div id="inspo-grid-1" class="inspo-grid grid grid-cols-2 gap-2 p-2">
                {shuffledImages.map((image, index) => {
                    const isWide = (index + 1) % 3 === 0;
                    const aspectClass = isWide ? 'aspect-video' : (index % 2 === 0 ? 'aspect-[3/4]' : 'aspect-square');

                    return (
                        <div class={`inspo-item group overflow-hidden bg-(--primary)/5 ${isWide ? 'col-span-2' : 'col-span-1'}`}>
                            <div class={`relative w-full h-full ${aspectClass} overflow-hidden`}>
                                <Image
                                    src={image.url}
                                    alt={image.caption || 'Inspiration image'}
                                    width={800}
                                    height={1200}
                                    loading={index < 6 ? "eager" : "lazy"}
                                    class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 ease-out scale-100 group-hover:scale-110 pointer-events-none"
                                />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4 pointer-events-none">
                                    <p class="text-white md:text-[1vw] text-[3vw] font-plain lowercase tracking-widest">
                                        {image.caption}
                                    </p>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </div>
</MainLayout>

<script is:inline>
    let animationId;
    let scrollPos = 0;
    let targetScrollPos = 0;
    const autoSpeed = 0.5;
    let isDragging = false;
    let startY = 0;
    let lastY = 0;
    let velocity = 0;

    function initInspoMarquee() {
        if (animationId) cancelAnimationFrame(animationId);
        
        const container = document.getElementById('inspo-container');
        const track = document.getElementById('inspo-track');
        const grid1 = document.getElementById('inspo-grid-1');
        if (!track || !grid1 || !container) return;

        // Shuffle
        const items = Array.from(grid1.children);
        for (let i = items.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            grid1.appendChild(items[j]);
        }

        const oldGrid2 = document.getElementById('inspo-grid-2');
        if (oldGrid2) oldGrid2.remove();

        const grid2 = grid1.cloneNode(true);
        grid2.id = 'inspo-grid-2';
        track.appendChild(grid2);

        // Manual Scroll / Drag Logic
        container.addEventListener('mousedown', (e) => {
            isDragging = true;
            startY = e.pageY;
            lastY = startY;
            velocity = 0;
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const deltaY = e.pageY - lastY;
            targetScrollPos -= deltaY;
            lastY = e.pageY;
            velocity = -deltaY;
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
        });

        // Touch support
        container.addEventListener('touchstart', (e) => {
            isDragging = true;
            startY = e.touches[0].pageY;
            lastY = startY;
            velocity = 0;
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            const deltaY = e.touches[0].pageY - lastY;
            targetScrollPos -= deltaY;
            lastY = e.touches[0].pageY;
            velocity = -deltaY;
        }, { passive: false });

        window.addEventListener('touchend', () => {
            isDragging = false;
        });

        // Mouse Wheel / Trackpad Scroll
        container.addEventListener('wheel', (e) => {
            e.preventDefault();
            targetScrollPos += e.deltaY * 0.8; // Reduced multiplier for more control
        }, { passive: false });

        function animate() {
            const gridHeight = grid1.offsetHeight;

            // Auto-advance target
            if (!isDragging) {
                targetScrollPos += autoSpeed;
            }

            // Lerp scrollPos towards targetScrollPos for "butter" smoothness
            // Lower values (e.g. 0.05) = smoother but more "laggy"
            // Higher values (e.g. 0.15) = more responsive
            const lerpFactor = 0.08;
            scrollPos += (targetScrollPos - scrollPos) * lerpFactor;

            // Decay velocity for inertia after drag
            if (!isDragging) {
                targetScrollPos += velocity;
                velocity *= 0.9; // Friction
                if (Math.abs(velocity) < 0.01) velocity = 0;
            }

            // Loop logic for both scrollPos and targetScrollPos to keep them synchronized
            if (scrollPos >= gridHeight) {
                scrollPos -= gridHeight;
                targetScrollPos -= gridHeight;
            } else if (scrollPos < 0) {
                scrollPos += gridHeight;
                targetScrollPos += gridHeight;
            }
            
            track.style.transform = `translateY(-${scrollPos}px)`;
            animationId = requestAnimationFrame(animate);
        }

        animate();
    }

    initInspoMarquee();
    document.addEventListener('astro:after-swap', initInspoMarquee);
    document.addEventListener('astro:before-swap', () => {
        if (animationId) cancelAnimationFrame(animationId);
    });
</script>

<style>
    .inspo-container {
        height: 100vh;
        touch-action: none;
    }

    .inspo-track {
        will-change: transform;
    }

    .inspo-grid {
        grid-auto-flow: dense;
    }

    @media (max-width: 768px) {
        .inspo-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

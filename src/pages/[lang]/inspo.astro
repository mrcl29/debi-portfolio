---
// src/pages/[lang]/inspo.astro
import MainLayout from '@/layouts/MainLayout.astro';
import { languages } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
      return { params: { lang } };
  });
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const images = t.pages.inspo.images || [];

// Shuffling on the server for initial static render
const shuffledImages = [...images].sort(() => Math.random() - 0.5);
---

<MainLayout title={t.pages.inspo.title} lang={lang as string}>
    <div id="inspo-container" class="inspo-container relative w-full h-full overflow-hidden bg-transparent cursor-grab active:cursor-grabbing select-none">
        <div id="inspo-track" class="inspo-track flex flex-col">
            <div id="inspo-grid-1" class="inspo-grid grid grid-cols-2 gap-2 p-2">
                {shuffledImages.map((image, index) => {
                    const isWide = (index + 1) % 3 === 0;
                    const aspectClass = isWide ? 'aspect-video' : (index % 2 === 0 ? 'aspect-[3/4]' : 'aspect-square');

                    return (
                        <div class={`inspo-item group overflow-hidden bg-(--primary)/5 ${isWide ? 'col-span-2' : 'col-span-1'}`}>
                            <div class={`relative w-full h-full ${aspectClass} overflow-hidden`}>
                                <Image
                                    src={image.url}
                                    alt={image.caption || 'Inspiration image'}
                                    width={800}
                                    height={1200}
                                    loading={index < 6 ? "eager" : "lazy"}
                                    class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 ease-out scale-100 group-hover:scale-110 pointer-events-none"
                                />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4 pointer-events-none">
                                    <p class="text-white md:text-[1vw] text-[3vw] font-plain lowercase tracking-widest">
                                        {image.caption}
                                    </p>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </div>
</MainLayout>

<script>
    let animationId: number | null = null;
    let cleanupListeners: (() => void) | null = null;

    function cleanupInspo() {
        if (animationId) {
            cancelAnimationFrame(animationId);
            animationId = null;
        }
        if (cleanupListeners) {
            cleanupListeners();
            cleanupListeners = null;
        }
    }

    function initInspoMarquee() {
        cleanupInspo();

        const container = document.getElementById('inspo-container') as HTMLElement | null;
        const track = document.getElementById('inspo-track') as HTMLElement | null;
        const grid1 = document.getElementById('inspo-grid-1') as HTMLElement | null;
        if (!track || !grid1 || !container) return;

        let scrollPos = 0;
        let targetScrollPos = 0;
        const autoSpeed = 0.5;
        let isDragging = false;
        let lastY = 0;
        let velocity = 0;

        // Shuffle
        const items = Array.from(grid1.children);
        for (let i = items.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            grid1.appendChild(items[j]);
        }

        const oldGrid2 = document.getElementById('inspo-grid-2');
        if (oldGrid2) oldGrid2.remove();

        const grid2 = grid1.cloneNode(true) as HTMLElement;
        grid2.id = 'inspo-grid-2';
        track.appendChild(grid2);

        // Event Handlers
        const onMouseDown = (e: MouseEvent) => {
            isDragging = true;
            lastY = e.pageY;
            velocity = 0;
        };

        const onMouseMove = (e: MouseEvent) => {
            if (!isDragging) return;
            const deltaY = e.pageY - lastY;
            targetScrollPos -= deltaY;
            lastY = e.pageY;
            velocity = -deltaY;
        };

        const onMouseUp = () => {
            isDragging = false;
        };

        const onTouchStart = (e: TouchEvent) => {
            isDragging = true;
            lastY = e.touches[0].pageY;
            velocity = 0;
        };

        const onTouchMove = (e: TouchEvent) => {
            if (!isDragging) return;
            const deltaY = e.touches[0].pageY - lastY;
            targetScrollPos -= deltaY;
            lastY = e.touches[0].pageY;
            velocity = -deltaY;
        };

        const onTouchEnd = () => {
            isDragging = false;
        };

        const onWheel = (e: WheelEvent) => {
            e.preventDefault();
            targetScrollPos += e.deltaY * 0.8;
        };

        container.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
        container.addEventListener('touchstart', onTouchStart, { passive: true });
        window.addEventListener('touchmove', onTouchMove, { passive: false });
        window.addEventListener('touchend', onTouchEnd);
        container.addEventListener('wheel', onWheel, { passive: false });

        cleanupListeners = () => {
            container.removeEventListener('mousedown', onMouseDown);
            window.removeEventListener('mousemove', onMouseMove);
            window.removeEventListener('mouseup', onMouseUp);
            container.removeEventListener('touchstart', onTouchStart);
            window.removeEventListener('touchmove', onTouchMove);
            window.removeEventListener('touchend', onTouchEnd);
            container.removeEventListener('wheel', onWheel);
        };

        function animate() {
            if (!track || !grid1) return;
            const gridHeight = grid1.offsetHeight;

            // Auto-advance target
            if (!isDragging) {
                targetScrollPos += autoSpeed;
            }

            // Lerp scrollPos towards targetScrollPos for "butter" smoothness
            const lerpFactor = 0.08;
            scrollPos += (targetScrollPos - scrollPos) * lerpFactor;

            // Decay velocity for inertia after drag
            if (!isDragging) {
                targetScrollPos += velocity;
                velocity *= 0.9; // Friction
                if (Math.abs(velocity) < 0.01) velocity = 0;
            }

            // Loop logic for both scrollPos and targetScrollPos to keep them synchronized
            if (scrollPos >= gridHeight) {
                scrollPos -= gridHeight;
                targetScrollPos -= gridHeight;
            } else if (scrollPos < 0) {
                scrollPos += gridHeight;
                targetScrollPos += gridHeight;
            }
            
            track.style.transform = `translateY(-${scrollPos}px)`;
            animationId = requestAnimationFrame(animate);
        }

        animate();
    }

    document.addEventListener('astro:page-load', initInspoMarquee);
    document.addEventListener('astro:before-swap', cleanupInspo);
</script>

<style>
    .inspo-container {
        height: 100vh;
        touch-action: none;
    }

    .inspo-track {
        will-change: transform;
    }

    .inspo-grid {
        grid-auto-flow: dense;
    }

    @media (max-width: 768px) {
        .inspo-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

---
import { languages } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import MainLayout from '@/layouts/MainLayout.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
      return { params: { lang } };
  });
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const socials = t.pages.contact.socials || {};
---

<MainLayout title={t.pages.contact.title} lang={lang as string}>
    <div class="contact-wrapper h-full flex items-center justify-center p-8 md:p-16 animate-in overflow-hidden">

        <div class="contact-content w-full max-w-4xl flex flex-col gap-12 md:gap-16">

            <!-- Contact Header: Email + Socials -->
            <div class="contact-links-section flex flex-col gap-6">

                <div class="links-group flex flex-wrap gap-x-10 gap-y-4 justify-center md:justify-start items-baseline">
                    <!-- Email as a primary social-style link -->
                    <a
                        href={`mailto:${t.pages.contact.email}`}
                        class="contact-link text-(--primary) text-2xl md:text-4xl font-light uppercase tracking-tighter hover:font-extrabold transition-all border-b-2 border-(--primary)/10 pb-1"
                        data-text={t.pages.contact.email}
                    >
                        Email
                    </a>

                    {Object.entries(socials).map(([key, url]) => (
                        <a
                            href={url.startsWith('http') ? url : `https://${url}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="social-link text-(--primary) text-2xl md:text-4xl font-light uppercase tracking-tighter hover:font-extrabold transition-all border-b-2 border-(--primary)/10 pb-1"
                        >
                            {key}
                        </a>
                    ))}
                </div>
            </div>

            <!-- Form Section -->
            <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-8 md:gap-12 w-full">
                <input type="hidden" name="access_key" value="b16635c9-71a4-4984-8791-f24b56668ab0">
                <input type="hidden" name="from_name" value="Debi Portfolio Contact">
                <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
                    <div class="flex flex-col gap-3">
                        <label for="name" class="text-[10px] md:text-xs uppercase font-plain tracking-widest opacity-60">
                            {t.pages.contact.form.name}
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            class="bg-transparent border-b-2 border-(--primary)/20 pb-4 focus:border-(--primary) outline-none transition-colors font-plain text-xl md:text-3xl"
                        >
                    </div>
                    <div class="flex flex-col gap-3">
                        <label for="email" class="text-[10px] md:text-xs uppercase font-plain tracking-widest opacity-60">
                            {t.pages.contact.form.email}
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="bg-transparent border-b-2 border-(--primary)/20 pb-4 focus:border-(--primary) outline-none transition-colors font-plain text-xl md:text-3xl"
                        >
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    <label for="message" class="text-[10px] md:text-xs uppercase font-plain tracking-widest opacity-60">
                        {t.pages.contact.form.message}
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="2"
                        required
                        class="bg-transparent border-b-2 border-(--primary)/20 pb-4 focus:border-(--primary) outline-none transition-colors font-plain text-xl md:text-3xl resize-none"
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="self-center md:self-start text-(--primary) text-4xl md:text-6xl uppercase tracking-tighter hover:font-extrabold  transition-all cursor-pointer border-none bg-transparent p-0 mt-4"
                >
                    {t.pages.contact.form.submit}
                </button>
            </form>
        </div>
    </div>
</MainLayout>

<script is:inline>
    // Animation script kept for consistency if needed, but simplified
    function initContactAnimation() {
        const links = document.querySelectorAll('.contact-link');
        const typeText = async (element) => {
            const fullText = element.getAttribute('data-text');
            if (!fullText) return;
            element.textContent = '';
            for (let i = 0; i < fullText.length; i++) {
                element.textContent += fullText.charAt(i);
                await new Promise(r => setTimeout(r, 20));
            }
        };
        // Removed auto-typing for "Email" text to maintain visual consistency with other links
    }
    document.addEventListener('astro:after-swap', initContactAnimation);
</script>

<style>
    .contact-wrapper {
        height: 100vh;
        overflow: hidden;
    }

    .animate-in {
        animation: fadeIn 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Input focus and autofill refinements */
    input:-webkit-autofill {
        -webkit-text-fill-color: var(--primary);
        -webkit-box-shadow: 0 0 0px 1000px transparent inset;
        transition: background-color 5000s ease-in-out 0s;
    }

    @media (max-width: 1024px) {
        .contact-wrapper {
            overflow-y: auto;
            height: auto;
            min-height: 100vh;
            padding: 4rem 2rem;
            align-items: flex-start;
        }
    }
</style>

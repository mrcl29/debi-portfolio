---
import { getLangFromUrl } from '@/i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
---

<header class="fixed top-0 left-0 w-full z-50 p-6 flex justify-between items-start pointer-events-none">
  <div class="pointer-events-auto">
    <a href={`/${lang}/`} class="text-(--primary) text-2xl no-underline uppercase tracking-tighter hover:opacity-70 transition-opacity duration-300">
      VOL.2
    </a>
  </div>
  
  <div class="flex items-center gap-4 pointer-events-auto">
    <ThemeToggle />
    <LanguagePicker />
  </div>
</header>

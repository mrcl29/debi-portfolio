---
// src/components/SectionNavBar.astro
import type { Section } from '@/i18n/types/langDict';

interface Props {
  sections: Section[];
}

const { sections } = Astro.props as Props;
---

<nav class="section-nav-container relative z-40 p-16 flex flex-col min-h-screen bg-transparent animate-in">
  <div class="spacer grow"></div>
  <ul class="flex flex-col list-none m-0 p-0">
    {
      sections?.map((section) => {
        const SectionComponent = section.component;
        return (
          <li class="section-item group opacity-0" data-id={section.id}>
            <button 
              class="section-title w-full text-left text-(--primary) text-[7vw] md:text-[7vw] font-light leading-[0.8] uppercase block tracking-tighter hover:font-extrabold transition-all duration-300 cursor-pointer appearance-none bg-transparent border-none p-0 h-[7vw] md:h-[7vw]"
              data-text={section.title}
            >
              {/* Text injected via JS */}
            </button>
            <div class="section-content max-h-0 opacity-0 overflow-hidden transition-all duration-500 ease-in-out">
              <div class="py-8">
                {SectionComponent && <SectionComponent />}
              </div>
            </div>
          </li>
        )
      })
    }
  </ul>
</nav>

<script is:inline>
  function initSections() {
    const nav = document.querySelector('.section-nav-container');
    const spacer = nav?.querySelector('.spacer');
    const items = document.querySelectorAll('.section-item');

    if (!nav || !spacer || items.length === 0) return;

    function fixSpacer() {
      spacer.style.flexBasis = 'auto';
      spacer.style.flexGrow = '1';

      const openStates = Array.from(items).map(item => {
        const content = item.querySelector('.section-content');
        const isOpen = !content.classList.contains('max-h-0');
        return { content, isOpen, maxHeight: content.style.maxHeight };
      });

      openStates.forEach(state => {
        if (state.isOpen) {
          state.content.classList.add('max-h-0');
          state.content.style.maxHeight = '0px';
        }
      });

      const height = spacer.offsetHeight;

      openStates.forEach(state => {
        if (state.isOpen) {
          state.content.classList.remove('max-h-0');
          state.content.style.maxHeight = state.maxHeight;
        }
      });

      spacer.style.flexGrow = '0';
      spacer.style.flexBasis = `${height}px`;
    }

    // --- Typewriter Logic ---
    const typeTitle = async (titleElement) => {
      const fullText = titleElement.getAttribute('data-text');
      titleElement.textContent = '';
      for (let i = 0; i < fullText.length; i++) {
        titleElement.textContent += fullText.charAt(i);
        await new Promise(r => setTimeout(r, 40));
      }
    };

    const runTypewriterSequence = async () => {
      for (const item of items) {
        item.classList.remove('opacity-0');
        const titleElement = item.querySelector('.section-title');
        await typeTitle(titleElement);
        await new Promise(r => setTimeout(r, 80));
      }
    };

    fixSpacer();
    runTypewriterSequence();

    window.removeEventListener('resize', fixSpacer);
    window.addEventListener('resize', fixSpacer);

    items.forEach(item => {
      const title = item.querySelector('.section-title');
      const content = item.querySelector('.section-content');

      title?.addEventListener('click', () => {
        const isOpen = !content.classList.contains('max-h-0');

        // Cerrar otros
        items.forEach(otherItem => {
          if (otherItem !== item) {
            const otherTitle = otherItem.querySelector('.section-title');
            const otherContent = otherItem.querySelector('.section-content');
            otherContent.classList.add('max-h-0', 'opacity-0');
            otherContent.style.maxHeight = '0px';
            otherTitle?.classList.remove('font-extrabold');
          }
        });

        if (!isOpen) {
          // Abrir actual
          content.classList.remove('max-h-0', 'opacity-0');
          content.style.maxHeight = content.scrollHeight + 'px';
          title?.classList.add('font-extrabold');
        } else {
          // Cerrar actual
          content.classList.add('max-h-0', 'opacity-0');
          content.style.maxHeight = '0px';
          title?.classList.remove('font-extrabold');
        }
      });
    });
  }

  initSections();
  document.addEventListener('astro:after-swap', initSections);
</script>

<style>
  .animate-in {
    animation: fadeInSlide 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

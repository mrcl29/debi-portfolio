---
// src/components/LanguagePicker.astro
import { languages } from '@/i18n/ui';
import { flags } from '@/i18n/flags';
import { getLangFromUrl } from '@/i18n/utils';
import { Image } from 'astro:assets';

// Definimos el tipo basado en las claves de la configuración central de idiomas
type Lang = keyof typeof languages;

const currentLang = getLangFromUrl(Astro.url) as Lang; // Forzamos el tipo aquí por seguridad

// Lógica de rutas
const { pathname } = Astro.url;

// IMPORTANTE: Usamos un Regex con '^' para asegurarnos de reemplazar SOLO al inicio de la URL
// Esto evita errores si tienes una página llamada /es/fiestas (no rompería la palabra fiestas)
const subpath = pathname.replace(new RegExp(`^/${currentLang}`), '');
const languageLabels: Record<Lang, string> = {
  es: 'ES',
  en: 'ENG',
  cat: 'CAT',
};
---

<div class="relative inline-block text-left font-plain">
  <button
    id="lang-menu-button"
    aria-label="Cambiar idioma"
    aria-expanded="false"
    class="bg-transparent border-none cursor-pointer p-0 transition-opacity duration-200 ease-in-out hover:opacity-70 text-(--primary) text-sm font-bold tracking-widest"
  >
    {languageLabels[currentLang]}
  </button>

  <ul
    id="lang-menu-list"
    class="absolute top-[120%] right-0 bg-(--background) border border-(--primary)/10 rounded-sm shadow-xl py-2 list-none min-w-[80px] z-50 transition-all duration-200 ease-in-out opacity-100 translate-y-0 [&.menu-closed]:opacity-0 [&.menu-closed]:-translate-y-2 [&.menu-closed]:pointer-events-none menu-closed"
  >
    {Object.entries(languages).map(([lang, label]) => {
      const langKey = lang as Lang;
      const isActive = langKey === currentLang;

      return (
        <li>
          <a
            href={`/${langKey}${subpath}`}
            class={`block px-4 py-2 no-underline text-xs transition-colors duration-200 text-(--primary) tracking-tighter ${
              isActive
                ? 'font-bold bg-(--primary)/5'
                : 'hover:bg-(--primary)/5'
            }`}
          >
            {languageLabels[langKey]}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  // Lógica para abrir/cerrar y cerrar al hacer click fuera
  const button = document.getElementById('lang-menu-button');
  const list = document.getElementById('lang-menu-list');

  if (button && list) {
    // Toggle menú
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      button.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      list.classList.toggle('menu-closed');
    });

    // Cerrar al hacer click fuera
    document.addEventListener('click', (e) => {
      if (!button.contains(e.target as Node) && !list.contains(e.target as Node)) {
        list.classList.add('menu-closed');
        button.setAttribute('aria-expanded', 'false');
      }
    });

    // Cerrar al presionar Escape (Accesibilidad)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        list.classList.add('menu-closed');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

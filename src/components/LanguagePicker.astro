---
// src/components/LanguagePicker.astro
import { languages } from '@/i18n/ui';
import { getLangFromUrl } from '@/i18n/utils';

// Definimos el tipo basado en las claves de la configuración central de idiomas
type Lang = keyof typeof languages;

const currentLang = getLangFromUrl(Astro.url);

// Lógica de rutas
const { pathname } = Astro.url;

// IMPORTANTE: Usamos un Regex con '^' para asegurarnos de reemplazar SOLO al inicio de la URL
const subpath = pathname.replace(new RegExp(`^/${currentLang}`), '');
const languageLabels: Record<Lang, string> = {
  es: 'ES',
  en: 'ENG',
  cat: 'CAT',
};
---

<div class="lang-picker-container relative inline-block text-left font-plain">
  <button
    aria-label="Cambiar idioma"
    aria-expanded="false"
    class="lang-menu-button bg-transparent border-none cursor-pointer p-0 transition-opacity duration-200 ease-in-out hover:opacity-70 text-(--primary) text-sm font-bold tracking-widest"
  >
    {languageLabels[currentLang]}
  </button>

  <ul
    class="lang-menu-list absolute top-[120%] right-0 bg-(--background) border border-(--primary)/10 rounded-sm shadow-xl py-2 list-none min-w-20 z-50 transition-all duration-200 ease-in-out opacity-100 translate-y-0 [&.menu-closed]:opacity-0 [&.menu-closed]:-translate-y-2 [&.menu-closed]:pointer-events-none menu-closed"
  >
    {Object.keys(languages).map((lang) => {
      const langKey = lang as Lang;
      const isActive = langKey === currentLang;

      return (
        <li>
          <a
            href={`/${langKey}${subpath}`}
            class={`block px-4 py-2 no-underline text-xs transition-colors duration-200 text-(--primary) tracking-tighter ${
              isActive
                ? 'font-bold bg-(--primary)/5'
                : 'hover:bg-(--primary)/5'
            }`}
          >
            {languageLabels[langKey]}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  let docListenersInitialized = false;

  function closeAllMenus() {
    const lists = document.querySelectorAll('.lang-menu-list');
    const buttons = document.querySelectorAll('.lang-menu-button');
    lists.forEach((list) => list.classList.add('menu-closed'));
    buttons.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
  }

  function initGlobalListeners() {
    if (docListenersInitialized) return;
    docListenersInitialized = true;

    // Cerrar al hacer click fuera
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      const containers = document.querySelectorAll('.lang-picker-container');
      let clickedInsideAny = false;
      containers.forEach((container) => {
        if (container.contains(target)) clickedInsideAny = true;
      });
      if (!clickedInsideAny) {
        closeAllMenus();
      }
    });

    // Cerrar al presionar Escape (Accesibilidad)
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeAllMenus();
      }
    });
  }

  function initLangMenu() {
    initGlobalListeners();

    const containers = document.querySelectorAll('.lang-picker-container');
    containers.forEach((container) => {
      const button = container.querySelector('.lang-menu-button') as HTMLButtonElement | null;
      const list = container.querySelector('.lang-menu-list') as HTMLElement | null;

      if (button && list) {
        button.onclick = (e) => {
          e.stopPropagation();
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          closeAllMenus();
          if (!isExpanded) {
            button.setAttribute('aria-expanded', 'true');
            list.classList.remove('menu-closed');
          }
        };
      }
    });
  }

  document.addEventListener('astro:page-load', initLangMenu);
</script>

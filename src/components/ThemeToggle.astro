---
// src/components/ThemeToggle.astro
import SunIcon from '@/components/icons/SunIcon.astro';
import MoonIcon from '@/components/icons/MoonIcon.astro';
---

<button
  id="theme-toggle"
  aria-label="Alternar tema oscuro/claro"
  class="cursor-pointer p-2 rounded-full transition-transform duration-200 ease-in-out hover:scale-110 text-(--primary) hover:bg-black/5 dark:hover:bg-white/10"
>
  <!-- Icono Sol (Visible en Dark Mode) -->
  <SunIcon class="sun-icon w-6 h-6 hidden" />

  <!-- Icono Luna (Visible en Light Mode) -->
  <MoonIcon class="moon-icon w-6 h-6 block" />
</button>

<style>
  :global(.dark) .sun-icon {
    display: block;
  }
  :global(.dark) .moon-icon {
    display: none;
  }
</style>

<script is:inline>
  // Lógica inmediata para evitar parpadeos (Flash of Unstyled Content)
  // Se mantiene inline para que se ejecute lo antes posible en cada carga de página
  (() => {
    const theme = localStorage.getItem('theme') || 
                 (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('theme', theme);
  })();
</script>

<script>
  function initThemeToggle() {
    const handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle('dark');

      const isDark = element.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };

    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
      // Evitar duplicar listeners si el script se re-ejecuta
      toggle.removeEventListener('click', handleToggleClick);
      toggle.addEventListener('click', handleToggleClick);
    }
  }

  // Inicializar al cargar y tras swap de View Transitions
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>

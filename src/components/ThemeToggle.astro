---
// src/components/ThemeToggle.astro
import SunIcon from '@/components/icons/SunIcon.astro';
import MoonIcon from '@/components/icons/MoonIcon.astro';
---

<button
  class="theme-toggle-btn cursor-pointer p-2 rounded-full transition-transform duration-200 ease-in-out hover:scale-110 text-(--primary) hover:bg-black/5 dark:hover:bg-white/10"
  aria-label="Alternar tema oscuro/claro"
>
  <!-- Icono Sol (Visible en Dark Mode) -->
  <SunIcon class="sun-icon w-6 h-6 hidden" />

  <!-- Icono Luna (Visible en Light Mode) -->
  <MoonIcon class="moon-icon w-6 h-6 block" />
</button>

<style>
  :global(.dark) .sun-icon {
    display: block;
  }
  :global(.dark) .moon-icon {
    display: none;
  }
</style>

<script>
  function setupThemeToggle() {
    const toggles = document.querySelectorAll('.theme-toggle-btn');
    toggles.forEach((toggle) => {
      (toggle as HTMLElement).onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };
    });
  }

  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

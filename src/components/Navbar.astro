---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Mapeo de las claves del menú a las rutas de archivo reales
const routes: Record<keyof typeof t.nav, string> = {
  projects: `/${lang}/Projects`,
  aboutMe: `/${lang}/AboutMe`,
  contact: `/${lang}/Contact`,
  inspo: `/${lang}/Inspo`,
};

const { pathname } = Astro.url;
// Normalizamos la URL actual (quitando slash final) para comparar correctamente
const currentPath = pathname.replace(/\/$/, '') || `/${lang}`;

const navEntries = Object.entries(t.nav);
---

<nav class="fixed top-0 left-0 h-screen w-full md:w-1/2 z-50 p-16 flex flex-col justify-end bg-transparent pointer-events-none overflow-hidden">
  <ul class="flex flex-col list-none m-0 p-0 pointer-events-auto">
    {
      navEntries.map(([key, label]) => {
        const routeKey = key as keyof typeof t.nav;
        const href = routes[routeKey];
        const normalizedHref = href.replace(/\/$/, '');
        const isActive = normalizedHref === currentPath;

        return (
          <li>
            <a
              href={href}
              class={`text-(--primary) text-[7vw] md:text-[7vw] no-underline transition-all hover:font-extrabold uppercase block tracking-tighter leading-none ${isActive ? 'font-extrabold' : 'font-light'}`}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

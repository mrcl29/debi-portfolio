---
// src/components/Navbar.astro
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { ownerName } from '@/constants/constants';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Mapeo de las claves del menú a las rutas de archivo reales
const routes: Record<keyof typeof t.nav, string> = {
  projects: `/${lang}/projects`,
  aboutMe: `/${lang}/about-me`,
  contact: `/${lang}/contact`,
  inspo: `/${lang}/inspo`,
  lastProject: `/${lang}/last-project`,
};

const { pathname } = Astro.url;
const currentPath = pathname.replace(/\/$/, '') || `/${lang}`;

const navEntries = Object.entries(t.nav);
---

<!-- ========================================== -->
<!-- 1. MÓVIL (< md): Menú desplegable (Drawer) -->
<!-- ========================================== -->

<!-- Símbolo interactivo fijado a la izquierda (solo móviles) -->
<button
  id="drawer-toggle"
  type="button"
  aria-label="Abrir menú de navegación"
  aria-expanded="false"
  class="md:hidden fixed top-6 left-6 z-[60] flex items-center justify-center w-11 h-11 rounded-full bg-(--background)/80 hover:bg-(--background) backdrop-blur-md border border-(--primary)/20 text-(--primary) cursor-pointer transition-all duration-300 shadow-sm group focus:outline-hidden"
>
  <span class="sr-only">Toggle navigation</span>
  <div class="relative w-5 h-3 flex flex-col justify-between items-center pointer-events-none">
    <span class="nav-line block h-[2px] w-5 bg-current rounded-full transition-all duration-300 origin-center"></span>
    <span class="nav-line block h-[2px] w-3 group-hover:w-5 bg-current rounded-full transition-all duration-300 origin-center"></span>
  </div>
</button>

<!-- Backdrop oscurecido al abrirse el drawer móvil -->
<div
  id="drawer-backdrop"
  class="md:hidden fixed inset-0 bg-black/40 dark:bg-black/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-500 ease-in-out"
  aria-hidden="true"
></div>

<!-- Panel desplegable móvil -->
<aside
  id="drawer-panel"
  aria-label="Menú principal móvil"
  class="md:hidden fixed inset-y-0 left-0 h-screen w-full z-50 bg-(--background) text-(--primary) shadow-2xl -translate-x-full transition-transform duration-500 ease-in-out flex flex-col justify-between overflow-y-auto"
>
  <!-- Barra superior del panel móvil: VOL.2 + ThemeToggle + LanguagePicker -->
  <div class="p-6 flex items-center justify-between border-b border-(--primary)/10 min-h-[72px]">
    <div class="flex items-center pl-12">
      <a
        href={`/${lang}/`}
        class="drawer-nav-link text-(--primary) text-2xl font-bold no-underline uppercase tracking-tighter hover:opacity-70 transition-opacity duration-300"
      >
        VOL.2
      </a>
    </div>

    <div class="flex flex-col items-end gap-1">
      <ThemeToggle />
      <LanguagePicker />
    </div>
  </div>

  <!-- Índice de navegación móvil -->
  <div class="p-8 flex-1 flex flex-col justify-end">
    <ul class="flex flex-col list-none m-0 p-0 gap-4">
      {
        navEntries.map(([key, label]) => {
          const routeKey = key as keyof typeof t.nav;
          const href = routes[routeKey];
          const normalizedHref = href.split('#')[0].replace(/\/$/, '');
          const isActive = normalizedHref === currentPath;

          return (
            <li>
              <a
                href={href}
                class={`drawer-nav-link text-(--primary) text-3xl sm:text-4xl leading-[0.88] no-underline transition-all duration-300 hover:font-extrabold uppercase block tracking-tighter break-words ${
                  isActive ? 'font-extrabold' : 'font-light'
                }`}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Pie del panel móvil -->
  <div class="p-8 pt-0 flex justify-between items-center text-xs opacity-40 uppercase tracking-widest font-plain">
    <span>Debora Milenova</span>
    <span>{ownerName} © {new Date().getFullYear()}</span>
  </div>
</aside>

<!-- ======================================================== -->
<!-- 2. TABLET Y ORDENADORES (>= md): Navegación fija original -->
<!-- ======================================================== -->
<nav class="hidden md:flex fixed inset-y-0 left-0 w-[40%] z-50 p-6 md:p-8 lg:p-10 flex-col justify-end bg-transparent pointer-events-none">
  <ul
    id="nav-list"
    class="relative flex flex-col list-none m-0 p-0 gap-1 md:gap-2 pointer-events-auto transition-transform duration-500 ease-in-out w-full"
  >
    {
      navEntries.map(([key, label]) => {
        const routeKey = key as keyof typeof t.nav;
        const href = routes[routeKey];
        const normalizedHref = href.split('#')[0].replace(/\/$/, '');
        const isActive = normalizedHref === currentPath;

        return (
          <li class="m-0 p-0 w-full">
            <a
              href={href}
              class={`text-(--primary) text-3xl sm:text-4xl md:text-[4.8vw] lg:text-[5vw] xl:text-[5.3vw] leading-[0.88] no-underline transition-all duration-300 hover:font-extrabold uppercase tracking-tighter block m-0 p-0 break-words ${isActive ? 'font-extrabold' : 'font-light'}`}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  #drawer-toggle.is-open .nav-line:first-child {
    transform: translateY(5px) rotate(45deg);
  }
  #drawer-toggle.is-open .nav-line:last-child {
    width: 1.25rem;
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script>
  // Lógica de panel desplegable para móviles
  function setupMobileDrawer() {
    const toggle = document.getElementById('drawer-toggle');
    const drawer = document.getElementById('drawer-panel');
    const backdrop = document.getElementById('drawer-backdrop');
    if (!toggle || !drawer || !backdrop) return;

    let isOpen = false;

    function openDrawer() {
      isOpen = true;
      toggle?.classList.add('is-open');
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Cerrar menú de navegación');
      drawer?.classList.remove('-translate-x-full');
      drawer?.classList.add('translate-x-0');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      isOpen = false;
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Abrir menú de navegación');
      drawer?.classList.add('-translate-x-full');
      drawer?.classList.remove('translate-x-0');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    }

    toggle.onclick = (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    };

    backdrop.onclick = () => {
      if (isOpen) closeDrawer();
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        closeDrawer();
      }
    };
    window.addEventListener('keydown', handleKeyDown);

    // Si se redimensiona a tablet/escritorio (>= 768px), cerrar automáticamente
    const handleResize = () => {
      if (window.innerWidth >= 768 && isOpen) {
        closeDrawer();
      }
    };
    window.addEventListener('resize', handleResize);

    // Cerrar al pulsar cualquier enlace del menú móvil
    const navLinks = drawer.querySelectorAll('.drawer-nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    // Limpieza antes del swap de ClientRouter
    document.addEventListener(
      'astro:before-swap',
      () => {
        closeDrawer();
        window.removeEventListener('keydown', handleKeyDown);
        window.removeEventListener('resize', handleResize);
      },
      { once: true }
    );
  }

  function initNav() {
    setupMobileDrawer();
  }

  document.addEventListener('astro:page-load', initNav);
</script>

---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
    id="intro-overlay"
    transition:persist
    class="fixed inset-0 z-[100] bg-(--background) flex items-center justify-center pointer-events-auto"
    data-phrases={JSON.stringify(t.intro.phrases)}
>
    <div class="w-250">
        <h1
            id="intro-text"
            class="text-(--primary) text-3xl md:text-6xl font-bold text-center px-4 opacity-0 transition-opacity duration-500"
        >
            <!-- El texto se inyectará vía JS -->
        </h1>
    </div>
</div>

<script is:inline>
    // Bloqueo inmediato para evitar que se vea la web si la animación debe ejecutarse.
    // Si ya se ha visto, ocultamos el overlay al instante.
    if (sessionStorage.getItem("hasSeenIntro")) {
        const overlay = document.getElementById("intro-overlay");
        if (overlay) overlay.style.display = "none";
    }
</script>

<script>
    const setupIntro = () => {
        const overlay = document.getElementById("intro-overlay") as HTMLElement | null;
        const textElement = document.getElementById("intro-text") as HTMLElement | null;
        if (!overlay || !textElement) return;

        // Si ya está oculto (por persistencia o script inline), no hacemos nada
        if (overlay.style.display === "none") return;

        const phrases = JSON.parse(overlay.dataset.phrases || "[]");
        const hasSeenIntro = sessionStorage.getItem("hasSeenIntro");

        if (!hasSeenIntro) {
            // La animación se ejecuta porque overlay es visible por defecto (sin la clase 'hidden')
            const typeText = async (text: string) => {
                textElement.textContent = "";
                textElement.style.opacity = "1";

                for (let i = 0; i < text.length; i++) {
                    textElement.textContent += text.charAt(i);
                    await new Promise((r) => setTimeout(r, 50));
                }
            };

            const fadeOutText = async () => {
                textElement.style.opacity = "0";
                await new Promise((r) => setTimeout(r, 500));
            };

            const runAnimation = async () => {
                await new Promise((r) => setTimeout(r, 500));

                if (phrases[0]) {
                    await typeText(phrases[0]);
                    await new Promise((r) => setTimeout(r, 600));
                    await fadeOutText();
                }

                if (phrases[1]) {
                    await typeText(phrases[1]);
                    await new Promise((r) => setTimeout(r, 600));
                    await fadeOutText();
                }

                overlay.style.transition = "opacity 1s ease-out";
                overlay.style.opacity = "0";

                sessionStorage.setItem("hasSeenIntro", "true");

                setTimeout(() => {
                    overlay.style.display = "none";
                    overlay.style.pointerEvents = "none";
                }, 1000);
            };

            runAnimation();
        } else {
            overlay.style.display = "none";
            overlay.style.pointerEvents = "none";
        }
    };

    // Ejecutar al cargar
    setupIntro();
</script>
